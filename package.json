    "next.js",
    "claude",
    "anthropic",
    "vision",
    "tool-use",
    "prompt-caching",
    "typescript",
    "zod",
    "vercel",
    "portfolio"
  ],
  "homepage": "https://github.com/Ink6x/history-soul-matcher#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ink6x/history-soul-matcher.git"
  },
  "bugs": {
    "url": "https://github.com/Ink6x/history-soul-matcher/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Jullien",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
