{
  "name": "history-soul-matcher",
  "version": "0.1.0",
  "private": true,
  "description": "Selfie-to-historical-figure matching web app. A 3-stage pipeline (Claude Vision + Tool Use → deterministic scoring → LLM narrative) eliminates hallucinations by removing person selection from the LLM entirely.",
