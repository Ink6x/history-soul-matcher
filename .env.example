# Anthropic API key (required)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Claude model IDs (single source of truth — never hardcode in src/)
# Stage 1 (feature extraction): Haiku is sufficient for closed-enum classification
CLAUDE_EXTRACT_MODEL=claude-haiku-4-5-20251001
# Stage 3 (narrative generation): Sonnet for user-facing quality
CLAUDE_NARRATIVE_MODEL=claude-sonnet-4-6
# Fallback used when stage-specific vars are not set
CLAUDE_MODEL=claude-sonnet-4-6

# Upstash Redis — per-IP rate limiting (10 req/h)
# https://console.upstash.com → create Redis database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
